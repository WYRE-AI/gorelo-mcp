# Single-tenant credential (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load this. Do not add it to
# that service's environment or via env_file.
GORELO_API_KEY=
# Region is not a credential. us (default) or au.
GORELO_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When CONDUIT_S2S_SECRET is set and MCP_HTTP_HOST is
# unset, the server binds 0.0.0.0 (container deploys). Set 127.0.0.1 to bind
# loopback. The insecure-dev bypass ignores a non-loopback value and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, change-me,
# secret, example, placeholder, replace-me, your-secret, your-s2s-secret,
# s2s-secret, replace-with-a-real-secret), so a copied example cannot forge
# X-Gateway-S2S. Compose will not start when it is unset.
# Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider address such as 0.0.0.0.
# A placeholder CONDUIT_S2S_SECRET still refuses to start.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# x-gorelo-api-key header; no env fallback). The container image and the
# compose service set gateway. Stdio ignores this and reads GORELO_API_KEY.
# AUTH_MODE=env

# Tool selection. Presets only narrow; DELETE tools stay off unless enabled.
# GORELO_PRESET=all            # all | readonly | crm | tickets | monitoring
# GORELO_ENABLE_DESTRUCTIVE=true
# Invoice/payment/item writes (not time entries) are off unless enabled.
# GORELO_ENABLE_BILLING_WRITES=true
# GORELO_TOOLS_INCLUDE=gorelo_*_ticket*,gorelo_list_clients
# GORELO_TOOLS_EXCLUDE=gorelo_create_*

LOG_LEVEL=info
